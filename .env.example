# Server
PORT=3333
HOST=0.0.0.0

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
REDIS_URI=https://valid-moose-232668.upstash.io
# Postgres connection string (for migrations). Format:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Option 1: set DATABASE_URL directly.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
# Option 2: leave DATABASE_URL empty and set the DB password below; the runner
# builds the URL from SUPABASE_URL + SUPABASE_DB_PASSWORD automatically.
SUPABASE_DB_PASSWORD=your-db-password

# OpenTelemetry
OTEL_EXPORTER_OTLP_URL=http://localhost:4318/v1/traces

# Application
NODE_ENV=development