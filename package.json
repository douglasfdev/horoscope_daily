{
  "name": "daily-sorte-astroengine",
  "version": "1.0.0",
  "description": "Micro SaaS de astrologia e sorte do dia - Local Libraries Edition",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/infrastructure/server.js",
    "dev": "tsx watch src/infrastructure/server.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs"
  },
  "keywords": [
    "astrology",
    "saaS",
    "horoscope",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fusionstrings/swiss-eph": "^0.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@supabase/supabase-js": "^2.117.3",
    "bull": "^4.12.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.0.0",
    "horoscopefree": "github:vitorebatista/horoscopefree",
    "inversify": "^8.2.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
